
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
#
# Groups
#
if {[catch {group get -using [list {CARR_arb}]}]} {
set createdGroup([list {CARR_arb}]) 1
catch {group new -name CARR_arb -overlay 0}
}
if {[catch {group get -using [list {FIFO_0}]}]} {
set createdGroup([list {FIFO_0}]) 1
catch {group new -name FIFO_0 -overlay 0}
}
if {[catch {group get -using [list {FIFO_7}]}]} {
set createdGroup([list {FIFO_7}]) 1
catch {group new -name FIFO_7 -overlay 0}
}
if {[catch {group get -using [list {FIFO_1}]}]} {
set createdGroup([list {FIFO_1}]) 1
catch {group new -name FIFO_1 -overlay 0}
}
if {[catch {group get -using [list {FIFO_5}]}]} {
set createdGroup([list {FIFO_5}]) 1
catch {group new -name FIFO_5 -overlay 0}
}
if {[info exists createdGroup([list {CARR_arb}])]} {
group using CARR_arb
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {tb_async_fifo_arb.CARR_arb_inst.almost_full[7:0]}]} ] \
    [subst  {[format {tb_async_fifo_arb.CARR_arb_inst.burst_cnt_d[3:0]}]} ] \
    [subst  {[format {tb_async_fifo_arb.CARR_arb_inst.burst_cnt_q[3:0]}]} ] \
    [subst  {[format {tb_async_fifo_arb.CARR_arb_inst.clk}]} ] \
    [subst  {[format {tb_async_fifo_arb.CARR_arb_inst.do_pop_slot}]} ] \
    [subst  {[format {tb_async_fifo_arb.CARR_arb_inst.empty[7:0]}]} ] \
    [subst  {[format {tb_async_fifo_arb.CARR_arb_inst.sel_idx_d[2:0]}]} ] \
    [subst  {[format {tb_async_fifo_arb.CARR_arb_inst.sel_idx_q[2:0]}]} ] \
    [subst  {[format {tb_async_fifo_arb.CARR_arb_inst.pop[7:0]}]} ] \
    [subst  {[format {tb_async_fifo_arb.CARR_arb_inst.rst_n}]} ]
}

