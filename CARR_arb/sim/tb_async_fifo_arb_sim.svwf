set groupId0 [waveform add -groups CARR_arb]

set id [waveform add -signals [subst  {
	{[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.ADDR_W}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.AFULL_MARGIN}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.PTR_W}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.DEPTH}]}
	} ]]

set groupId0 [waveform add -groups FIFO_0]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wclk}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wrst_n}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wpush}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.walmost_full}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.used_w[8:0]}]} {-radix %d}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wfull}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wbin_d[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wbin_q[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wgray_d[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wgray_q[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wgray_r1[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wgray_r2[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wgray_sync_r[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rclk}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.ralmost_full}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rbin_d[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rbin_q[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rbin_sync_w[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rempty}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rgray_d[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rgray_q[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rgray_sync_w[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rgray_w1[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rgray_w2[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rpop}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rrst_n}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.rused[8:0]}]} {-radix %d}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.used_r[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wbin_sync_r[8:0]}]} {}
    {[format {tb_async_fifo_arb.G_FIFOS[0].u_fifo.wgray_next[8:0]}]} {}
}] childcmds {
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups FIFO_1]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
