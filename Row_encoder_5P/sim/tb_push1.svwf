
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
set id [waveform add -signals [subst  {
	{[format {tb_push1.EN}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.one_bit}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.clk40m}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.rstn}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.pix_valid}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.pix_gray[14:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.pix_mask[4:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.enc_ready}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.enc_data[15:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.IDLE}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.PUSH}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.WAIT}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.ALARM}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.silence_counter[14:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.wake_up_flag}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.data_flag}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.repeating_pattern[14:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.pixel_1bit[4:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.first_push}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.current_state[2:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.next_state[2:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.acc_counter[1:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_push1.dut.acc_temp_pattern[9:0]}]}
	} ]]

waveform xview limits 0 606250ps
